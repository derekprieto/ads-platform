# Database (Supabase Postgres in production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ads

# AI providers. Leave empty to use the built-in mock providers (no cost, fake images).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

# Auth: "dev" signs everyone in as a dev user. "supabase" for production.
AUTH_MODE=dev
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage: "local" writes to ./.data/media. "supabase" uses Supabase Storage.
STORAGE_MODE=local

# Stripe (billing step)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Safety
GENERATION_ENABLED=true
